---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Joule Standard">
  <header class="masthead">
    <div class="wrap">
      <h1 class="title">Money you can<br />redeem for a <em class="unit">kilowatt-hour</em></h1>
      <p class="subtitle">
        An open protocol for currencies backed by delivered energy — designed to resist inflation, speculation, and capture. Reference currency: the joulemark.
      </p>
      <div class="pulse-line masthead-end" aria-hidden="true">
        <svg viewBox="0 0 760 46" role="img" aria-label="A stylised electrical load curve">
          <path
            d="M0 34 H120 L150 34 160 10 172 40 184 22 196 34 H340 L352 34 362 8 376 42 388 20 400 34 H560 L572 34 582 12 594 38 606 24 618 34 H760"
            fill="none"
            stroke="#D98E14"
            stroke-width="2"
            class="flow"
          />
          <path d="M0 34 H760" fill="none" stroke="#DCDCD2" stroke-width="1" />
        </svg>
      </div>
    </div>
  </header>
  <main>
    <div class="wrap">
      <p><a href="/spec">Read the specification →</a></p>
      <p><a href="/manifesto">Read the companion essay, “Energy Is Honest” →</a></p>
    </div>
  </main>
</BaseLayout>
