---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('docs', 'spec');
if (!entry) {
  throw new Error('spec.md was not found in src/content/docs — run `pnpm content:sync` first.');
}
const { Content } = await render(entry);
---

<BaseLayout title="The Joule Standard — Specification">
  <main>
    <div class="wrap">
      <Content />
    </div>
  </main>
</BaseLayout>
